@model RetroGamingWorld.Models.Category

@{
    ViewData["Title"] = "Adaugă Categorie";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8">

        <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-3 shadow-sm bg-white border-start border-5 border-success">
            <div>
                <h1 class="display-6 fw-bold mb-0">✨ Adaugă Categorie</h1>
                <p class="text-muted mb-0">Creează o nouă categorie pentru produse.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Înapoi
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-5">
                <form asp-action="New">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-4">
                        <label asp-for="CategoryName" class="form-label fw-bold">Nume Categorie</label>
                        <input asp-for="CategoryName" class="form-control form-control-lg" placeholder="Ex: Nintendo, PlayStation..." />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg shadow-sm">
                            <i class="bi bi-check-lg"></i> Adaugă Categorie
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}