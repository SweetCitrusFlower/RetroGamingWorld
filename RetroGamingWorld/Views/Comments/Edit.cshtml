@model RetroGamingWorld.Models.Comment

@{
    ViewData["Title"] = "Editare comentariu";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8">

        <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-3 shadow-sm bg-white border-start border-5 border-warning">
            <div>
                <h1 class="display-6 fw-bold mb-0">✏️ Editare comentariu</h1>
                <p class="text-muted mb-0">Ți-ai schimbat părerea? Modifică recenzia aici.</p>
            </div>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Înapoi
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-5">
                <form method="post" asp-action="Edit" asp-controller="Comments" asp-route-id="@Model.Id">

                    <div class="mb-4">
                        <label class="form-label fw-bold mb-2">Ratingul produsului</label>
                        <div class="d-flex flex-wrap gap-3 border rounded-3 p-3 bg-light">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Rating" value="@i" id="rating_@i" />
                                    <label class="form-check-label fw-bold" for="rating_@i">
                                        @i ⭐
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Rating" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-bold">Conținut comentariu</label>
                        <textarea asp-for="Content" class="form-control form-control-lg" rows="5" placeholder="Scrie aici noua ta opinie..."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning text-white btn-lg shadow-sm">
                            <i class="bi bi-save-fill"></i> Salvează Modificările
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}