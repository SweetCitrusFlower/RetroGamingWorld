@model RetroGamingWorld.Models.ApplicationUser

@{
    ViewData["Title"] = "Editează Utilizator";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6">

        <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded-3 shadow-sm bg-white border-start border-5 border-primary">
            <div>
                <h1 class="display-6 fw-bold mb-0">👤 Editează rol</h1>
                <p class="text-muted mb-0">Modifică drepturile utilizatorului.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Înapoi
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-5">

                <div class="text-center mb-4">
                    <h4 class="fw-bold">@Model.UserName</h4>
                </div>

                <form asp-controller="Users" asp-action="Edit" method="post" asp-route-id="@Model.Id">

                    <div class="mb-4">
                        <label class="form-label fw-bold">Selectează Rolul</label>
                        <select name="newRole" class="form-select form-select-lg">
                            <option>Selectati rolul</option>
                            @foreach (var role in ViewBag.AllRoles)
                            {
                                @if (ViewBag.UserRole == role.Value)
                                {
                                    <option selected="selected" value="@role.Value">@role.Text</option>
                                }
                                else
                                {
                                    <option value="@role.Value">@role.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-check-lg"></i> Salvează Modificările
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>